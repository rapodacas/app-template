# App
APP_NAME={{app-name}}
PORT=3000
NODE_ENV=development

# Database (uncomment the one you need)
# DATABASE_URL=./data/app.db          # SQLite
# DATABASE_URL=postgres://user:pass@localhost:5432/dbname  # Postgres
# MONGODB_URI=mongodb://localhost:27017/dbname             # MongoDB

# Staging URL (used by Playwright e2e tests)
# STAGING_URL=https://your-app-staging.railway.app
